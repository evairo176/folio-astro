---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../lib/content";
import { t } from "../../lib/i18n";

const lang = "id" as const;
const projects = await getProjects();
const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<BaseLayout title={t(lang, "projectsPage.title")} description={t(lang, "projectsPage.subtitle")} path="/projects" lang={lang}>
  <div class="p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <h1 class="text-2xl lg:text-3xl font-semibold font-sora">{t(lang, "projectsPage.title")}</h1>
    <p class="text-muted-foreground mt-1">{t(lang, "projectsPage.subtitle")}</p>
  </div>

  {projects.length === 0 ? (
    <p class="mt-6 text-sm text-muted-foreground">{t(lang, "projectsPage.empty")}</p>
  ) : (
    <>
      {featured.length > 0 && (
        <section class="mt-6">
          <h2 class="text-lg font-semibold font-sora">Featured</h2>
          <div class="mt-3 space-y-3">
            {featured.map((p) => (
              <a href={`/projects/${p.slug}`} class="group block rounded-md border bg-card text-card-foreground overflow-hidden hover:ring-1 hover:ring-sky-500/40 transition-all sm:flex">
                {p.cover && <img src={p.cover} alt={p.title} loading="lazy" width="320" height="180" class="sm:w-72 aspect-video w-full object-cover sm:aspect-auto sm:h-full" />}
                <div class="p-4 lg:p-5 flex-1">
                  <h3 class="font-semibold font-sora group-hover:text-sky-500">{p.title}</h3>
                  <p class="mt-1 text-sm text-muted-foreground">{p.description}</p>
                  <ul class="mt-3 flex flex-wrap gap-1.5">
                    {p.tags.slice(0, 5).map((tag) => (
                      <li class="rounded border bg-secondary text-secondary-foreground px-2 py-0.5 text-[11px]">{tag}</li>
                    ))}
                  </ul>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="mt-6">
        <h2 class="text-lg font-semibold font-sora">All projects</h2>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {rest.map((p) => (
            <a href={`/projects/${p.slug}`} class="group rounded-md border bg-card text-card-foreground overflow-hidden hover:ring-1 hover:ring-sky-500/40 transition-all">
              {p.cover && <img src={p.cover} alt={p.title} loading="lazy" width="400" height="225" class="aspect-video w-full object-cover" />}
              <div class="p-4">
                <h3 class="font-medium font-sora text-sm group-hover:text-sky-500">{p.title}</h3>
                <p class="mt-1 text-xs text-muted-foreground line-clamp-3">{p.description}</p>
                <p class="mt-2 text-[11px] text-muted-foreground">{p.date}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </>
  )}
</BaseLayout>

<style is:inline>
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
