---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../lib/content";
import { t } from "../../lib/i18n";

const lang = "id" as const;
const projects = await getProjects();
---

<BaseLayout title={t(lang, "projectsPage.title")} description={t(lang, "projectsPage.subtitle")} path="/projects" lang={lang}>
  <div class="p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <h1 class="flex items-center gap-3 text-2xl lg:text-3xl font-semibold font-sora flex-wrap">
      {t(lang, "projectsPage.title")}
      <span class="rounded-full bg-sky-500/10 text-sky-500 text-sm font-medium px-3 py-1">{projects.length} projects</span>
    </h1>
    <p class="text-muted-foreground mt-1">{t(lang, "projectsPage.subtitle")}</p>
  </div>

  {projects.length === 0 ? (
    <p class="mt-6 text-muted-foreground">{t(lang, "projectsPage.empty")}</p>
  ) : (
    <div class="mt-4 grid sm:grid-cols-2 gap-3">
      {projects.map((p) => (
        <a href={`/projects/${p.slug}/`} class="group rounded-md border bg-card text-card-foreground overflow-hidden hover:shadow-md hover:-translate-y-1 duration-200 transition-all flex flex-col h-full">
          {p.images && p.images.length > 0 && (
            <div class="relative">
              <img src={p.images[0]} alt={p.title} loading="lazy" class="w-full h-44 object-cover object-top bg-muted" />
              {p.images.length > 1 && (
                <span class="absolute bottom-2 right-2 text-[11px] bg-black/60 text-white rounded px-1.5 py-0.5">+{p.images.length - 1}</span>
              )}
            </div>
          )}
          <div class="p-5 flex flex-col flex-1">
            <div class="flex items-start justify-between gap-2">
              <div class="space-y-0.5">
                <h2 class="font-semibold font-sora group-hover:text-sky-500 transition-colors">{p.title}</h2>
                {p.company && <p class="text-[11px] uppercase tracking-wide text-sky-500">{p.company}</p>}
              </div>
              <svg class="size-4 text-muted-foreground shrink-0 group-hover:text-sky-500 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 17 17 7M7 7h10v10" />
              </svg>
            </div>
            {p.description && <p class="text-sm text-muted-foreground mt-2 flex-1 line-clamp-3">{p.description}</p>}
            {p.tags && p.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mt-3">
                {p.tags.map((tag) => (
                  <span class="text-[11px] bg-muted rounded px-1.5 py-0.5 text-muted-foreground">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  )}
</BaseLayout>

<style is:inline>
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
