---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../lib/content";
import { getCollection, render } from "astro:content";
import { t } from "../../lib/i18n";
import { SITE } from "../../lib/profile";

export async function getStaticPaths() {
  const projects = await getProjects();
  const entries = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p, entry: entries.find((e) => e.id === p.slug)! },
  }));
}

const { project, entry } = Astro.props;
const lang = "id" as const;

// Entry carries its own `.render()`; the markdown is converted to HTML at build
// time so the response ships real text, no client-side markdown parsing.
const { Content } = await render(entry);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.title,
  description: project.description,
  dateCreated: project.date,
  url: new URL(`/projects/${project.slug}`, SITE.url).toString(),
  author: { "@type": "Person", name: SITE.name, url: SITE.url },
  keywords: project.tags.join(", "),
};
---

<BaseLayout
  title={project.title}
  description={project.description}
  path={`/projects/${project.slug}`}
  lang={lang}
  jsonLd={jsonLd}
  ogType="article"
  ogImage={project.cover ?? "/og-default.png"}
  publishedAt={project.date}
  tags={project.tags}
>
  <a href="/projects" class="text-sm text-muted-foreground hover:text-foreground">← {t(lang, "sections.backToProjects")}</a>

  <article class="mt-3">
    <header class="p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
      <h1 class="text-2xl lg:text-3xl font-semibold font-sora">{project.title}</h1>
      <p class="text-muted-foreground mt-2">{project.description}</p>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
        <span>{project.date}</span>
      </div>
      {project.tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {project.tags.map((tag) => (
            <li class="rounded border bg-secondary text-secondary-foreground px-2 py-0.5 text-[11px]">{tag}</li>
          ))}
        </ul>
      )}
    </header>

    {project.metrics.length > 0 && (
      <section class="mt-4 grid gap-3 sm:grid-cols-3">
        {project.metrics.map((m) => {
          const [value, label] = m.split("|").map((s) => s.trim());
          return (
            <div class="rounded-md border bg-card text-card-foreground p-4">
              <p class="text-lg font-semibold font-sora text-sky-500">{value}</p>
              {label && <p class="text-xs text-muted-foreground mt-0.5">{label}</p>}
            </div>
          );
        })}
      </section>
    )}

    {project.cover && (
      <img src={project.cover} alt={project.title} width="854" height="480" class="mt-4 w-full rounded-md border object-cover" loading="eager" />
    )}

    <div class="prose-article mt-6">
      <Content />
    </div>

    {project.images.length > 0 && (
      <section class="mt-8">
        <h2 class="text-lg font-semibold font-sora">Screenshots</h2>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {project.images.map((src, i) => (
            <img src={src} alt={`${project.title} screenshot ${i + 1}`} width="400" height="225" loading="lazy" class="rounded-md border object-cover aspect-video w-full" />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
