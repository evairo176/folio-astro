---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, uniqueSlugs, pickPost, estimateReadMinutes } from "../../lib/content";
import { t } from "../../lib/i18n";

const lang = "id" as const;
const posts = await getPosts();
const entries = uniqueSlugs(posts)
  .map((slug) => pickPost(posts, slug, lang))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .sort((a, b) => (a.date < b.date ? 1 : -1));

// Mirrors the legacy CATEGORIES map; a post lands in a category when any of its
// tags matches a keyword.
const CATEGORIES = [
  { id: "ai", label: "AI & RAG", keywords: ["ai", "rag", "llm", "architecture"] },
  { id: "data", label: "Data Engineering", keywords: ["data engineering", "apache spark", "spark", "airflow", "etl"] },
  { id: "devops", label: "DevOps", keywords: ["devops", "ci/cd", "github actions", "github", "automation"] },
  { id: "frontend", label: "Frontend", keywords: ["react", "nextjs", "next.js", "server-components", "web-vitals", "javascript"] },
  { id: "security", label: "Security", keywords: ["security", "authentication", "microservices", "node.js"] },
  { id: "systems", label: "Systems", keywords: ["rust", "systems-programming", "concurrency", "golang", "postgresql"] },
  { id: "gis", label: "GIS", keywords: ["gis", "turf.js"] },
];

const matches = (tags: string[], keywords: string[]) => {
  const lower = tags.map((x) => x.toLowerCase());
  return keywords.some((kw) => lower.includes(kw));
};

const available = CATEGORIES.filter((cat) => entries.some((p) => matches(p.tags ?? [], cat.keywords)));
---

<BaseLayout title={t(lang, "blog.title")} description={t(lang, "blog.subtitle")} path="/blogs" lang={lang}>
  <div class="p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <h1 class="text-2xl lg:text-3xl font-semibold font-sora">{t(lang, "blog.title")}</h1>
    <p class="text-muted-foreground mt-1">{t(lang, "blog.subtitle")}</p>
  </div>

  {entries.length === 0 ? (
    <p class="mt-6 text-muted-foreground">{t(lang, "blog.empty")}</p>
  ) : (
    <>
      <div role="tablist" aria-label={t(lang, "blog.title")} class="mt-4 flex flex-wrap gap-2">
        <button role="tab" data-cat="all" aria-selected="true" class="cat-tab rounded-md border px-3 py-1.5 text-sm font-medium">Semua</button>
        {available.map((cat) => (
          <button role="tab" data-cat={cat.id} aria-selected="false" class="cat-tab rounded-md border px-3 py-1.5 text-sm font-medium">{cat.label}</button>
        ))}
      </div>

      <div class="mt-4 space-y-3">
        {entries.map((p) => {
          const cats = available.filter((c) => matches(p.tags ?? [], c.keywords)).map((c) => c.id).join(" ");
          return (
            <a href={`/blogs/${p.slug}/`} data-cats={cats} class="post-card group block p-4 lg:p-6 rounded-md border bg-card text-card-foreground hover:shadow-sm hover:-translate-y-1 transition-all duration-200">
              <article class="space-y-2">
                <h2 class="text-lg lg:text-xl font-semibold font-sora group-hover:text-sky-500 transition-colors">{p.title}</h2>
                {p.description && <p class="text-muted-foreground line-clamp-2">{p.description}</p>}
                <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                  <span>{p.date}</span>
                  <span>·</span>
                  <span>{estimateReadMinutes(p.body)} {t(lang, "sections.minRead")}</span>
                  {(p.tags ?? []).slice(0, 3).map((tag) => (
                    <span class="bg-muted rounded px-1.5 py-0.5">{tag}</span>
                  ))}
                </div>
              </article>
            </a>
          );
        })}
      </div>
    </>
  )}
</BaseLayout>

<style is:inline>
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cat-tab { background: hsl(var(--card)); color: hsl(var(--muted-foreground)); cursor: pointer; transition: color .15s, border-color .15s; }
  .cat-tab:hover { color: hsl(var(--foreground)); border-color: rgb(14 165 233 / .5); }
  .cat-tab[aria-selected="true"] { background: rgb(14 165 233); border-color: rgb(14 165 233); color: #fff; }
  .post-card.is-hidden { display: none; }
</style>

<script is:inline>
  (() => {
    const tabs = document.querySelectorAll(".cat-tab");
    const cards = document.querySelectorAll(".post-card");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const cat = tab.dataset.cat;
        tabs.forEach((x) => x.setAttribute("aria-selected", String(x === tab)));
        cards.forEach((card) => {
          const cats = (card.dataset.cats || "").split(" ").filter(Boolean);
          card.classList.toggle("is-hidden", cat !== "all" && !cats.includes(cat));
        });
      });
    });
  })();
</script>
