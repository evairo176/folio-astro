---
import BaseLayout from "../layouts/BaseLayout.astro";

const groups = [
  {
    title: "💻 Editor & Terminal",
    items: [
      { name: "VS Code", note: "Editor utama - TypeScript, ESLint, Prettier, GitLens." },
      { name: "Cursor / AI pair", note: "Untuk eksplorasi cepat dan refactor berbantuan AI." },
      { name: "Windows Terminal + WSL2", note: "Ubuntu di WSL2 untuk semua kerja shell, Docker, dan tooling Linux." },
      { name: "zsh + oh-my-zsh", note: "Shell harian dengan git plugin dan autosuggestions." },
    ],
  },
  {
    title: "🧰 Bahasa & Framework",
    items: [
      { name: "TypeScript", note: "Default untuk frontend dan backend Node." },
      { name: "React / Next.js", note: "UI dan SSR - App Router untuk proyek baru." },
      { name: "Golang", note: "Service backend yang butuh throughput dan binary tunggal." },
      { name: ".NET / C#", note: "Internal tools enterprise di Fiberstar." },
      { name: "Python", note: "Data engineering (Spark/Airflow) dan scripting." },
    ],
  },
  {
    title: "🗄️ Data & Infra",
    items: [
      { name: "PostgreSQL", note: "Database pilihan utama - index, RLS, query tuning." },
      { name: "Redis", note: "Cache, rate-limit, dan state in-flight." },
      { name: "Docker + Compose", note: "Semua dev environment dan deploy berjalan di container." },
      { name: "nginx", note: "Reverse proxy, TLS (certbot), security headers." },
      { name: "GitHub Actions (self-hosted runner)", note: "Self-hosted runner di VPS sendiri - kontrol penuh, tanpa biaya menit CI." },
      { name: "CI/CD pipeline", note: "Build, test, dan deploy otomatis - memangkas waktu deploy dari ~30 menit jadi di bawah 5." },
      { name: "Linux VPS + systemd", note: "Host produksi, service-supervision, dan cron." },
    ],
  },
  {
    title: "🛠️ Tools Harian",
    items: [
      { name: "Git + GitHub", note: "Version control, PR workflow, GitHub Actions CI." },
      { name: "TanStack Query + Zustand", note: "Server-state dan client-state di setiap frontend." },
      { name: "Zod", note: "Validasi runtime dan kontrak tipe end-to-end." },
      { name: "Tailwind + shadcn/ui", note: "Sistem desain yang konsisten dan cepat." },
      { name: "Cloudflare", note: "DNS, proxy, Workers, dan Web Analytics." },
    ],
  },
];
---

<BaseLayout
  title="Uses — Dicki Prasetya"
  description="Perangkat, software, dan layanan yang saya pakai untuk ngoding dan menjalankan proyek sehari-hari."
  path="/uses"
  lang="id"
>
  <div class="p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <h1 class="text-2xl lg:text-3xl font-semibold font-sora">Uses</h1>
    <p class="text-muted-foreground mt-1">Perangkat, software, dan layanan yang saya pakai untuk ngoding dan menjalankan proyek sehari-hari.</p>
    <p class="text-xs text-muted-foreground mt-2">Diperbarui Juni 2026</p>
  </div>

  <div class="mt-4 grid gap-4 md:grid-cols-2">
    {groups.map((group) => (
      <section class="p-4 lg:p-6 rounded-md border bg-card text-card-foreground">
        <h2 class="text-lg font-semibold font-sora">{group.title}</h2>
        <ul class="mt-3 space-y-3">
          {group.items.map((item) => (
            <li class="text-[15px]">
              <span class="font-medium text-foreground">{item.name}</span>
              <span class="text-muted-foreground"> - {item.note}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
