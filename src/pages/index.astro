---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, STATS, SKILL_GROUPS, CORE_STACK, EXPERIENCE, EDUCATION, CERTIFICATIONS, CV_URL, CV_PDF_URL, SOCIAL } from "../lib/profile";
import { t } from "../lib/i18n";
import { getProjects, getPosts, pickPost, estimateReadMinutes } from "../lib/content";

const lang = "id" as const;

const allProjects = await getProjects();
const projects = allProjects.slice(0, 4);
const totalProjects = allProjects.length;

const posts = await getPosts();
const latestPosts = posts
  .filter((p) => p.lang === "id")
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 3)
  .map((p) => ({ slug: p.slug, ...pickPost(posts, p.slug, lang) ?? p }));

// Brand marks for the stack grid. Simple Icons paths inlined so the page stays
// zero-JS; colour comes from the brand value in profile.ts.
const ICONS: Record<string, string> = {
