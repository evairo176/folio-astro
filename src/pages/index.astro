  "React": "M14 10.44c-.36 0-.7.06-1.02.18a2.28 2.28 0 0 0-1.1 3.1 2.28 2.28 0 0 0 3.11 1.1A2.28 2.28 0 0 0 16.28 12a2.28 2.28 0 0 0-2.28-1.56zm0-2.87c2.44 0 4.72.36 6.42.99.5.19.94.4 1.32.63a5.29 5.29 0 0 1 1.1.81c.6.63.6 1.44 0 2.07a5.3 5.3 0 0 1-1.1.81c-.38.23-.82.44-1.32.63-1.7.63-3.98.99-6.42.99-2.44 0-4.72-.36-6.42-.99-.5-.19-.94-.4-1.32-.63a5.3 5.3 0 0 1-1.1-.81c-.6-.63-.6-1.44 0-2.07a5.3 5.3 0 0 1 1.1-.81c.38-.23.82-.44 1.32-.63C9.28 7.93 11.56 7.57 14 7.57zm0-2.87c2.86 0 5.5.42 7.42 1.13 1.06.4 2 .89 2.71 1.65.72.77.72 1.83 0 2.6-.71.76-1.65 1.25-2.71 1.65-1.92.71-4.56 1.13-7.42 1.13-2.86 0-5.5-.42-7.42-1.13-1.06-.4-2-.89-2.71-1.65-.72-.77-.72-1.83 0-2.6C4.58 5.72 5.52 5.23 6.58 4.83 8.5 4.12 11.14 3.7 14 3.7z",
