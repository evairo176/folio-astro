  ".NET / C#": "M24 8.77h-2.468v7.565h-1.425V8.77h-2.462V7.53H24zm-6.852 7.565h-4.821V7.53h4.63v1.24h-3.205v2.494h2.953v1.234h-2.953v2.604h3.396zm-6.708 0H8.882L4.78 9.863a2.896 2.896 0 0 1-.258-.51h-.036c.032.189.048.592.048 1.21v5.772H3.157V7.53h1.659l3.965 6.32c.167.261.275.442.323.54h.024c-.04-.233-.059-.634-.059-1.203V7.53h1.355z",
  "Docker": "M13.983 11.078h2.119a.186.186 0 0 0 .186-.185V9.006a.186.186 0 0 0-.186-.186h-2.119a.185.185 0 0 0-.185.185v1.888c0 .102.083.185.185.185m-2.954-5.43h2.118a.186.186 0 0 0 .186-.186V3.574a.186.186 0 0 0-.186-.185h-2.118a.185.185 0 0 0-.185.185v1.888c0 .102.082.185.185.185m0 2.716h2.118a.187.187 0 0 0 .186-.186V6.29a.186.186 0 0 0-.186-.185h-2.118a.185.185 0 0 0-.185.185v1.887c0 .102.082.185.185.186m-2.93 0h2.12a.186.186 0 0 0 .184-.186V6.29a.185.185 0 0 0-.185-.185H8.1a.185.185 0 0 0-.185.185v1.887c0 .102.083.185.185.186m-2.964 0h2.119a.186.186 0 0 0 .185-.186V6.29a.185.185 0 0 0-.185-.185H5.136a.186.186 0 0 0-.186.185v1.887c0 .102.084.185.186.186m5.893 2.715h2.118a.186.186 0 0 0 .186-.185V9.006a.186.186 0 0 0-.186-.186h-2.118a.185.185 0 0 0-.185.185v1.888c0 .102.082.185.185.185m-2.93 0h2.12a.185.185 0 0 0 .184-.185V9.006a.185.185 0 0 0-.184-.186h-2.12a.185.185 0 0 0-.184.185v1.888c0 .102.083.185.185.185m-2.964 0h2.119a.185.185 0 0 0 .185-.185V9.006a.185.185 0 0 0-.185-.186h-2.119a.186.186 0 0 0-.185.185v1.888c0 .102.083.185.185.185m-2.92 0h2.12a.185.185 0 0 0 .184-.185V9.006a.185.185 0 0 0-.185-.186h-2.118a.186.186 0 0 0-.186.185v1.888c0 .102.083.185.185.185M23.763 9.89c-.065-.051-.672-.51-1.954-.51-.338.001-.676.03-1.01.087-.248-1.7-1.653-2.53-1.716-2.566l-.344-.199-.226.327c-.284.438-.49.922-.612 1.43-.23.97-.09 1.882.403 2.661-.595.332-1.55.413-1.744.42H.751a.751.751 0 0 0-.75.748 11.376 11.376 0 0 0 .692 4.062c.545 1.428 1.355 2.48 2.41 3.124 1.18.723 3.1 1.137 5.275 1.137.983.003 1.963-.086 2.93-.266a12.248 12.248 0 0 0 3.823-1.389c.98-.567 1.86-1.288 2.61-2.136 1.252-1.418 1.998-2.997 2.553-4.4h.221c1.372 0 2.215-.549 2.68-1.009.309-.293.55-.65.707-1.046l.098-.288Z",
};

const techGrid = CORE_STACK.map((tech) => ({
  ...tech,
  path: ICONS[tech.name] ?? null,
}));

const homeJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  jobTitle: SITE.role,
  url: SITE.url,
  image: new URL("/avatar.jpg", SITE.url).toString(),
  email: `mailto:${SOCIAL.email}`,
  sameAs: [SOCIAL.github, SOCIAL.linkedin],
  address: { "@type": "PostalAddress", addressCountry: "ID", addressRegion: "Indonesia" },
};
---

<BaseLayout
  title="Dicki Prasetya — Senior Fullstack Developer"
  description="Portfolio Dicki Prasetya: Senior Fullstack Developer specializing in .NET, React/Next.js, Node.js, Golang, data engineering, and DevOps."
  path="/"
  lang={lang}
  jsonLd={homeJsonLd}
>
  <!-- Introduction -->
  <section class="relative overflow-hidden p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 size-64 rounded-full bg-gradient-to-br from-sky-500/20 via-cyan-400/10 to-transparent blur-3xl"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-32 -left-20 size-72 rounded-full bg-gradient-to-tr from-indigo-500/15 via-sky-400/10 to-transparent blur-3xl"></div>

    <div class="relative flex justify-between items-center gap-3 flex-wrap">
      <div class="flex gap-2 text-2xl lg:text-3xl font-medium font-sora">
        <h1>{t(lang, "intro.greeting")}</h1>
        <span aria-hidden="true" class="inline-block wave">👋</span>
      </div>
      <div class="flex items-center gap-2">
        <a href={CV_URL} target="_blank" rel="noreferrer" aria-label={t(lang, "intro.viewCv")} class="inline-flex items-center gap-1.5 rounded-md bg-secondary text-secondary-foreground px-3 h-8 text-sm font-medium hover:opacity-90">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
          <span class="hidden sm:inline">{t(lang, "intro.viewCv")}</span>
        </a>
        <a href={CV_PDF_URL} download aria-label={t(lang, "intro.downloadCv")} class="inline-flex items-center gap-1.5 rounded-md bg-primary text-primary-foreground px-3 h-8 text-sm font-medium hover:opacity-90">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          <span class="hidden sm:inline">{t(lang, "intro.downloadCv")}</span>
        </a>
      </div>
    </div>

    <div class="relative space-y-4 mt-4">
      <p class="text-sm lg:text-base font-medium bg-gradient-to-r from-sky-500 to-cyan-400 bg-clip-text text-transparent">{t(lang, "intro.roles")}</p>
      <p class="text-sm lg:text-base text-muted-foreground">{t(lang, "intro.location")} <span class="ml-1">🇮🇩</span></p>
      <p class="leading-[1.8] md:leading-loose text-neutral-800 dark:text-neutral-300 text-justify">{t(lang, "intro.bio")}</p>
    </div>
  </section>

  <!-- Stats -->
  <section class="mt-4 p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {STATS.map((s) => (
        <div class="group rounded-md border bg-background p-4 text-center transition-shadow hover:shadow-md hover:border-sky-500/40 hover:-translate-y-1 duration-200">
          <div class="text-2xl lg:text-3xl font-bold font-sora text-sky-500 transition-transform group-hover:scale-105">{s.value}</div>
          <div class="text-xs lg:text-sm text-muted-foreground mt-1">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Career -->
  <section class="space-y-4 mt-4 p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <div class="space-y-1">
      <h2 class="flex items-center text-xl font-semibold font-sora">
        <svg class="mr-2 size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        {t(lang, "sections.experience")}
      </h2>
      <p class="text-sm text-muted-foreground">{t(lang, "sections.experienceSub")}</p>
    </div>
    <ol class="relative border-l border-border ml-2">
      {EXPERIENCE.map((row) => (
        <li class="group mb-8 ml-6 last:mb-0">
          <span class="absolute -left-3 grid place-items-center size-6 rounded-full bg-muted ring-4 ring-background transition-colors group-hover:bg-sky-500 group-hover:text-white">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </span>
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="font-medium font-sora group-hover:text-sky-500 transition-colors">{row.title}</h3>
            {row.highlight && (
              <span class="text-[10px] uppercase tracking-wide bg-primary text-primary-foreground rounded px-1.5 py-0.5">Now</span>
            )}
          </div>
          <p class="text-sm text-muted-foreground">{row.org}</p>
          <p class="text-xs text-muted-foreground mt-0.5">{row.period} · {row.location}</p>
          {row.bullets.length > 0 && (
            <ul class="mt-2 space-y-1.5 list-disc pl-5 text-sm leading-relaxed text-justify marker:text-muted-foreground">
              {row.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </section>

  <!-- Skills -->
  <section class="space-y-4 mt-4 p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <div class="space-y-1">
      <h2 class="flex items-center text-xl font-semibold font-sora">
        <svg class="mr-2 size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5M2 12l10 5 10-5"/></svg>
        {t(lang, "sections.skills")}
      </h2>
      <p class="text-sm text-muted-foreground">{t(lang, "sections.skillsSub")}</p>
    </div>
    <div class="space-y-4">
      {SKILL_GROUPS.map((group) => (
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground mb-2">{group.label}</p>
          <ul class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="bg-muted rounded-xl px-3 py-1.5 text-sm cursor-default transition-colors hover:bg-sky-500/15 hover:text-sky-500">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Tech stack -->
  <section class="space-y-4 mt-4 p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <div class="space-y-1">
      <h2 class="flex items-center text-xl font-semibold font-sora">
        <svg class="mr-2 size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/></svg>
        {t(lang, "sections.techStack")}
      </h2>
      <p class="text-sm text-muted-foreground">{t(lang, "sections.techStackSub")}</p>
    </div>
    <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-5">
      {techGrid.map((tech) => (
        <div class="group flex flex-col items-center justify-center gap-2 rounded-xl border bg-muted/40 px-2 py-4 text-center transition-all hover:border-sky-500/40 hover:bg-muted hover:shadow-md hover:-translate-y-1 duration-200">
          {tech.path ? (
            <svg class="size-8 transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24" fill={`#${tech.color.replace("#", "")}`} aria-hidden="true"><path d={tech.path} /></svg>
          ) : (
            <span class="size-8 rounded-full" style={`background:${tech.color}`} aria-hidden="true"></span>
          )}
          <span class="text-xs font-medium text-muted-foreground group-hover:text-foreground">{tech.name}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Projects preview -->
  {projects.length > 0 && (
    <section class="space-y-4 mt-4 p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
      <div class="flex items-center justify-between gap-3">
        <div class="space-y-1">
          <h2 class="flex items-center text-xl font-semibold font-sora">
            <svg class="mr-2 size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            {t(lang, "sections.projects")}
            <span class="ml-3 rounded-full bg-sky-500/10 text-sky-500 text-xs font-medium px-2.5 py-0.5">{totalProjects} projects</span>
          </h2>
          <p class="text-sm text-muted-foreground">{t(lang, "sections.projectsSub")}</p>
        </div>
        <a href="/projects/" class="text-sm text-sky-500 hover:underline whitespace-nowrap">{t(lang, "sections.viewAll")}</a>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        {projects.map((p) => (
          <a href={`/projects/${p.slug}/`} class="group block rounded-md border bg-background overflow-hidden hover:shadow-md hover:border-sky-500/40 transition-all h-full hover:-translate-y-1 duration-200">
            {p.images && p.images.length > 0 && (
              <img src={p.images[0]} alt={p.title} loading="lazy" class="w-full h-32 object-cover object-top bg-muted transition-transform duration-300 group-hover:scale-105" />
            )}
            <div class="p-4">
              <h3 class="font-medium font-sora group-hover:text-sky-500 transition-colors">{p.title}</h3>
              {p.company && <p class="text-[11px] uppercase tracking-wide text-sky-500 mt-0.5">{p.company}</p>}
              {p.description && <p class="text-sm text-muted-foreground line-clamp-2 mt-1">{p.description}</p>}
              {p.tags && p.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {p.tags.slice(0, 4).map((tag) => (
                    <span class="text-[11px] bg-muted rounded px-1.5 py-0.5 text-muted-foreground">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Education -->
  <section class="space-y-4 mt-4 p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <div class="space-y-1">
      <h2 class="flex items-center text-xl font-semibold font-sora">
        <svg class="mr-2 size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        {t(lang, "sections.education")}
      </h2>
      <p class="text-sm text-muted-foreground">{t(lang, "sections.educationSub")}</p>
    </div>
    <ol class="relative border-l border-border ml-2">
      {EDUCATION.map((row) => (
        <li class="mb-6 ml-6 last:mb-0">
          <span class="absolute -left-3 grid place-items-center size-6 rounded-full bg-muted ring-4 ring-background">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          </span>
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="font-medium font-sora">{row.title}</h3>
            {row.grade && <span class="text-[10px] uppercase tracking-wide bg-muted text-muted-foreground rounded px-1.5 py-0.5">{row.grade}</span>}
          </div>
          <p class="text-sm text-muted-foreground">{row.org}</p>
          <p class="text-xs text-muted-foreground mt-0.5">{row.period} · {row.location}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Certifications -->
  <section class="space-y-4 mt-4 p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <div class="space-y-1">
      <h2 class="flex items-center text-xl font-semibold font-sora">
        <svg class="mr-2 size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="m8.21 13.89-1.21 7.11 5-3 5 3-1.21-7.12"/></svg>
        {t(lang, "sections.certifications")}
      </h2>
      <p class="text-sm text-muted-foreground">{t(lang, "sections.certificationsSub")}</p>
    </div>
    <div class="grid sm:grid-cols-2 gap-3">
      {CERTIFICATIONS.map((c) => (
        <div class="flex flex-col rounded-md border bg-background p-4 hover:shadow-md hover:border-sky-500/40 transition-all">
          {c.thumbnail && (
            <img src={c.thumbnail} alt={c.title} loading="lazy" class="aspect-[16/9] w-full rounded-md border object-cover object-top bg-muted" />
          )}
          <p class="mt-3 font-medium text-sm font-sora leading-snug">{c.title}</p>
          <p class="text-xs text-muted-foreground mt-1">{c.issuer} · {c.date}</p>
          {c.credentialUrl && (
            <a href={c.credentialUrl} target="_blank" rel="noreferrer" class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-primary hover:underline">
              Lihat kredensial
              <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M7 7h10v10"/></svg>
            </a>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Blog preview -->
  {latestPosts.length > 0 && (
    <section class="space-y-4 mt-4 p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
      <div class="flex items-center justify-between gap-3">
        <div class="space-y-1">
          <h2 class="flex items-center text-xl font-semibold font-sora">
            <svg class="mr-2 size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8"/></svg>
            {t(lang, "sections.blogs")}
          </h2>
          <p class="text-sm text-muted-foreground">{t(lang, "sections.blogsSub")}</p>
        </div>
        <a href="/blogs/" class="text-sm text-sky-500 hover:underline whitespace-nowrap">{t(lang, "sections.viewAll")}</a>
      </div>
      <ul class="divide-y divide-border">
        {latestPosts.map((p) => (
          <li class="py-3 first:pt-0">
            <a href={`/blogs/${p.slug}/`} class="group block">
              <h3 class="font-medium font-sora group-hover:text-sky-500 transition-colors">{p.title}</h3>
              {p.description && <p class="text-sm text-muted-foreground line-clamp-2 mt-0.5">{p.description}</p>}
              <p class="text-xs text-muted-foreground mt-1">{p.date} · {estimateReadMinutes(p.body)} {t(lang, "sections.minRead")}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style is:inline>
  @keyframes wave-hand { 0%, 100% { transform: rotate(0deg); } 50% { transform: rotate(20deg); } }
  .wave { display: inline-block; animation: wave-hand 1s ease-in-out infinite; transform-origin: 70% 70%; }
  @media (prefers-reduced-motion: reduce) { .wave { animation: none; } }
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
