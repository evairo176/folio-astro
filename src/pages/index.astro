  "Node.js": "M11.998 24c-.321 0-.641-.084-.922-.247L8.14 21.815c-.438-.245-.224-.332-.08-.383.515-.18.62-.22 1.17-.533.058-.033.134-.021.193.014l2.256 1.34a.255.255 0 0 0 .242 0l8.795-5.076a.245.245 0 0 0 .12-.213V7.038a.25.25 0 0 0-.122-.216l-8.793-5.07a.245.245 0 0 0-.241 0L3.884 6.82a.247.247 0 0 0-.123.213v10.139c0 .086.047.168.123.212l2.409 1.39c1.308.653 2.108-.116 2.108-.89V7.789c0-.126.1-.224.226-.224h1.115c.124 0 .226.098.226.224v10.095c0 1.757-.957 2.764-2.623 2.764-.512 0-.916 0-2.042-.554l-2.305-1.327a1.845 1.845 0 0 1-.922-1.598V7.038c0-.659.353-1.27.922-1.601L12.92.36a1.926 1.926 0 0 1 1.919 0l8.795 5.077c.57.33.924.942.924 1.6v10.14c0 .658-.354 1.27-.924 1.603l-8.795 5.077a1.899 1.899 0 0 1-.84.243zM13.09 16.44c-3.848 0-4.652-1.766-4.652-3.248 0-.124.102-.224.227-.224h1.136c.113 0 .207.081.225.19.153 1.034.61 1.556 3.064 1.556 1.886 0 2.689-.426 2.689-1.428 0-.577-.227-1.004-3.159-1.29-2.449-.242-3.963-.782-3.963-2.739 0-1.802 1.52-2.876 4.068-2.876 2.862 0 4.28.994 4.46 3.125a.228.228 0 0 1-.058.18.225.225 0 0 1-.167.076h-1.142a.226.226 0 0 1-.217-.173c-.244-1.087-.84-1.435-2.876-1.435-2.117 0-2.306.738-2.306 1.289 0 .67.283.864 3.062 1.242 2.75.374 4.058.903 4.058 2.833 0 1.945-1.623 3.061-4.482 3.061z",
