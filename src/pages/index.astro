---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, STATS, SKILL_GROUPS, CORE_STACK, EXPERIENCE, EDUCATION, CERTIFICATIONS, CV_URL, CV_PDF_URL, SOCIAL } from "../lib/profile";
import { t, tList } from "../lib/i18n";
import { getProjects, getPosts, pickPost, estimateReadMinutes } from "../lib/content";

const lang = "id" as const;

const projects = (await getProjects()).slice(0, 3);
const posts = await getPosts();
const latestPosts = posts
  .filter((p) => p.lang === "en")
  .slice(0, 3)
  .map((p) => ({ ...p, preview: pickPost(posts, p.slug, lang) ?? p }));

const homeJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  jobTitle: SITE.role,
  url: SITE.url,
  image: new URL("/avatar.jpg", SITE.url).toString(),
  email: `mailto:${SOCIAL.email}`,
  sameAs: [SOCIAL.github, SOCIAL.linkedin],
  address: { "@type": "PostalAddress", addressCountry: "ID", addressRegion: "Indonesia" },
};
---

<BaseLayout
  title="Dicki Prasetya — Senior Fullstack Developer"
  description="Portfolio Dicki Prasetya: Senior Fullstack Developer specializing in .NET, React/Next.js, Node.js, Golang, data engineering, and DevOps."
  path="/"
  lang={lang}
  jsonLd={homeJsonLd}
>
  <!-- Introduction -->
  <section class="relative overflow-hidden p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 size-64 rounded-full bg-gradient-to-br from-sky-500/20 via-cyan-400/10 to-transparent blur-3xl"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-32 -left-20 size-72 rounded-full bg-gradient-to-tr from-indigo-500/15 via-sky-400/10 to-transparent blur-3xl"></div>

    <div class="relative flex justify-between items-center gap-3 flex-wrap">
      <div class="flex gap-2 text-2xl lg:text-3xl font-medium font-sora">
        <h1>{t(lang, "intro.greeting")}</h1>
        <span aria-hidden="true" class="inline-block wave">👋</span>
      </div>
      <div class="flex items-center gap-2">
        <a href={CV_URL} target="_blank" rel="noreferrer" aria-label={t(lang, "intro.viewCv")} class="inline-flex items-center gap-1.5 rounded-md bg-secondary text-secondary-foreground px-3 h-8 text-sm font-medium hover:opacity-90">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" /></svg>
          <span class="hidden sm:inline">{t(lang, "intro.viewCv")}</span>
        </a>
        <a href={CV_PDF_URL} download aria-label={t(lang, "intro.downloadCv")} class="inline-flex items-center gap-1.5 rounded-md bg-primary text-primary-foreground px-3 h-8 text-sm font-medium hover:opacity-90">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" /></svg>
          <span class="hidden sm:inline">{t(lang, "intro.downloadCv")}</span>
        </a>
      </div>
    </div>

    <p class="relative mt-3 text-muted-foreground text-sm lg:text-base">{t(lang, "intro.bio")}</p>
    <p class="relative mt-2 text-sm text-muted-foreground flex flex-wrap gap-x-3 gap-y-1">
      <span>{t(lang, "intro.roles")}</span>
      <span aria-hidden="true">·</span>
      <span>{t(lang, "intro.location")}</span>
    </p>
  </section>

  <!-- Stats -->
  <section class="mt-4 grid grid-cols-2 lg:grid-cols-3 gap-3">
    {STATS.map((s) => (
      <div class="rounded-md border bg-card text-card-foreground p-4">
        <p class="text-xl lg:text-2xl font-semibold font-sora">{s.value}</p>
        <p class="text-xs lg:text-sm text-muted-foreground mt-0.5">{s.label}</p>
      </div>
    ))}
  </section>

  <!-- Experience -->
  <section class="mt-8">
    <h2 class="text-xl lg:text-2xl font-semibold font-sora">{t(lang, "sections.experience")}</h2>
    <p class="text-sm text-muted-foreground mt-1">{t(lang, "sections.experienceSub")}</p>
    <div class="mt-4 space-y-3">
      {EXPERIENCE.map((job) => (
        <article class:list={["rounded-md border p-4 lg:p-5 bg-card text-card-foreground", job.highlight && "ring-1 ring-sky-500/30"]}>
          <div class="flex justify-between items-start gap-3 flex-wrap">
            <div>
              <h3 class="font-semibold font-sora">{job.title}</h3>
              <p class="text-sm text-muted-foreground">{job.org} · {job.location}</p>
            </div>
            <span class="text-xs px-2 py-1 rounded border bg-secondary text-secondary-foreground whitespace-nowrap">{job.period}</span>
          </div>
          <ul class="mt-3 space-y-1.5 text-sm text-muted-foreground list-disc pl-5">
            {job.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Skills -->
  <section class="mt-8">
    <h2 class="text-xl lg:text-2xl font-semibold font-sora">{t(lang, "sections.skills")}</h2>
    <p class="text-sm text-muted-foreground mt-1">{t(lang, "sections.skillsSub")}</p>
    <div class="mt-4 space-y-4">
      {SKILL_GROUPS.map((group) => (
        <div>
          <p class="text-sm font-medium">{group.label}</p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-md border bg-card px-2.5 py-1 text-xs text-card-foreground">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Tech stack -->
  <section class="mt-8">
    <h2 class="text-xl lg:text-2xl font-semibold font-sora">{t(lang, "sections.techStack")}</h2>
    <p class="text-sm text-muted-foreground mt-1">{t(lang, "sections.techStackSub")}</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {CORE_STACK.map((tech) => (
        <li class="flex items-center gap-2 rounded-md border bg-card px-3 py-2 text-sm text-card-foreground">
          <span aria-hidden="true" class="size-2 rounded-full" style={`background:${tech.color}`}></span>
          {tech.name}
        </li>
      ))}
    </ul>
  </section>

  <!-- Projects preview -->
  <section class="mt-8">
    <div class="flex items-baseline justify-between gap-3">
      <div>
        <h2 class="text-xl lg:text-2xl font-semibold font-sora">{t(lang, "sections.projects")}</h2>
        <p class="text-sm text-muted-foreground mt-1">{t(lang, "sections.projectsSub")}</p>
      </div>
      <a href="/projects" class="text-sm text-sky-500 hover:underline whitespace-nowrap">{t(lang, "sections.viewAll")}</a>
    </div>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <a href={`/projects/${p.slug}`} class="group rounded-md border bg-card text-card-foreground overflow-hidden hover:ring-1 hover:ring-sky-500/40 transition-all">
          {p.cover && <img src={p.cover} alt={p.title} loading="lazy" width="400" height="225" class="aspect-video w-full object-cover" />}
          <div class="p-4">
            <h3 class="font-medium font-sora text-sm group-hover:text-sky-500">{p.title}</h3>
            <p class="mt-1 text-xs text-muted-foreground line-clamp-2">{p.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Education -->
  <section class="mt-8">
    <h2 class="text-xl lg:text-2xl font-semibold font-sora">{t(lang, "sections.education")}</h2>
    <p class="text-sm text-muted-foreground mt-1">{t(lang, "sections.educationSub")}</p>
    <div class="mt-4 space-y-3">
      {EDUCATION.map((ed) => (
        <article class="rounded-md border p-4 bg-card text-card-foreground">
          <div class="flex justify-between items-start gap-3 flex-wrap">
            <div>
              <h3 class="font-semibold font-sora text-sm">{ed.title}</h3>
              <p class="text-sm text-muted-foreground">{ed.org} · {ed.location}</p>
              {ed.grade && <p class="text-xs text-emerald-500 mt-0.5">{ed.grade}</p>}
            </div>
            <span class="text-xs px-2 py-1 rounded border bg-secondary text-secondary-foreground whitespace-nowrap">{ed.period}</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Certifications -->
  <section class="mt-8">
    <h2 class="text-xl lg:text-2xl font-semibold font-sora">{t(lang, "sections.certifications")}</h2>
    <p class="text-sm text-muted-foreground mt-1">{t(lang, "sections.certificationsSub")}</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {CERTIFICATIONS.slice(0, 6).map((c) => (
        <article class="rounded-md border p-4 bg-card text-card-foreground">
          <h3 class="font-medium text-sm font-sora">{c.title}</h3>
          <p class="text-xs text-muted-foreground mt-1">{c.issuer} · {c.date}</p>
          {c.credentialUrl && (
            <a href={c.credentialUrl} target="_blank" rel="noreferrer" class="mt-2 inline-block text-xs text-sky-500 hover:underline">Verify credential</a>
          )}
        </article>
      ))}
    </div>
    <a href="/uses" class="mt-3 inline-block text-sm text-sky-500 hover:underline">{t(lang, "sections.viewAll")}</a>
  </section>

  <!-- Blog preview -->
  <section class="mt-8">
    <div class="flex items-baseline justify-between gap-3">
      <div>
        <h2 class="text-xl lg:text-2xl font-semibold font-sora">{t(lang, "sections.blogs")}</h2>
        <p class="text-sm text-muted-foreground mt-1">{t(lang, "sections.blogsSub")}</p>
      </div>
      <a href="/blogs" class="text-sm text-sky-500 hover:underline whitespace-nowrap">{t(lang, "sections.viewAll")}</a>
    </div>
    <div class="mt-4 space-y-3">
      {latestPosts.map((p) => (
        <a href={`/blogs/${p.slug}`} class="block rounded-md border p-4 bg-card text-card-foreground hover:ring-1 hover:ring-sky-500/40 transition-all">
          <h3 class="font-medium font-sora text-sm">{p.preview.title}</h3>
          <p class="mt-1 text-xs text-muted-foreground line-clamp-2">{p.preview.description}</p>
          <p class="mt-2 text-xs text-muted-foreground">{p.preview.date} · {estimateReadMinutes(p.preview.body)} {t(lang, "sections.minRead")}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style is:inline>
  @keyframes wave-hand { 0%, 100% { transform: rotate(0deg); } 50% { transform: rotate(20deg); } }
  .wave { display: inline-block; animation: wave-hand 1s ease-in-out infinite; transform-origin: 70% 70%; }
  @media (prefers-reduced-motion: reduce) { .wave { animation: none; } }
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
