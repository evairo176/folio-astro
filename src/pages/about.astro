---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t, tList } from "../lib/i18n";
import { STATS, SOCIAL } from "../lib/profile";

const lang = "id" as const;
const paras = tList(lang, "about.body");
const principles = tList(lang, "about.principles");
---

<BaseLayout title={t(lang, "about.title")} description={t(lang, "about.subtitle")} path="/about" lang={lang}>
  <div class="p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <h1 class="text-2xl lg:text-3xl font-semibold font-sora">{t(lang, "about.title")}</h1>
    <p class="text-muted-foreground mt-1">{t(lang, "about.subtitle")}</p>
  </div>

  <section class="mt-4 p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <div class="space-y-4">
      {paras.map((p) => <p class="text-[15px] leading-relaxed text-foreground/90">{p}</p>)}
    </div>
  </section>

  {principles.length > 0 && (
    <section class="mt-4 p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
      <h2 class="text-lg lg:text-xl font-semibold font-sora">{t(lang, "about.principlesTitle")}</h2>
      <ul class="mt-3 space-y-2">
        {principles.map((p) => (
          <li class="flex gap-2 text-[15px] text-foreground/90">
            <span aria-hidden="true" class="text-sky-500 mt-1">▹</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mt-4 p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {STATS.map((s) => (
        <div class="rounded-md border bg-background p-4 text-center">
          <div class="text-2xl lg:text-3xl font-bold font-sora text-sky-500">{s.value}</div>
          <div class="text-xs lg:text-sm text-muted-foreground mt-1">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-4 p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <h2 class="text-lg lg:text-xl font-semibold font-sora">{t(lang, "about.githubTitle")}</h2>
    <p class="text-sm text-muted-foreground mt-1">{t(lang, "about.githubSub")}</p>
    <a href={SOCIAL.github} target="_blank" rel="noreferrer" class="mt-4 block overflow-x-auto rounded-md border bg-background p-3 transition-colors hover:border-sky-500/40">
      <img src="https://ghchart.rshah.org/0ea5e9/evairo176" alt={t(lang, "about.githubAlt")} loading="lazy" width="640" height="120" class="min-w-[640px] w-full" />
    </a>
  </section>

  <section class="mt-4 p-4 lg:p-8 rounded-md border bg-card text-card-foreground">
    <h2 class="text-lg lg:text-xl font-semibold font-sora">{t(lang, "about.ctaHeader")}</h2>
    <p class="text-[15px] text-foreground/90 mt-2">{t(lang, "about.cta")}</p>
    <div class="mt-4 flex gap-2 flex-wrap">
      <a href="/contact" class="inline-flex items-center rounded-md bg-primary text-primary-foreground px-4 h-9 text-sm font-medium hover:opacity-90">{t(lang, "nav.contact")}</a>
      <a href={SOCIAL.github} target="_blank" rel="noreferrer" class="inline-flex items-center rounded-md bg-secondary text-secondary-foreground px-4 h-9 text-sm font-medium hover:opacity-90">GitHub</a>
    </div>
  </section>
</BaseLayout>
