---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Halaman tidak ditemukan" description="Halaman yang Anda cari tidak ada." path="/404" lang="id" noindex>
  <div class="p-6 lg:p-10 rounded-md border bg-card text-card-foreground text-center">
    <p class="text-5xl font-bold font-sora text-sky-500">404</p>
    <h1 class="mt-3 text-xl font-semibold font-sora">Halaman tidak ditemukan</h1>
    <p class="mt-2 text-sm text-muted-foreground">Halaman yang Anda cari tidak ada atau sudah dipindahkan.</p>
    <a href="/" class="mt-5 inline-flex items-center rounded-md bg-primary text-primary-foreground px-4 h-9 text-sm font-medium hover:opacity-90">Kembali ke beranda</a>
  </div>
</BaseLayout>
