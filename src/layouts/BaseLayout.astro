---
import "../styles/global.css";
import { SITE, SOCIAL, AVATAR_URL } from "../lib/profile";
import { t, type Lang } from "../lib/i18n";

export interface Props {
  title?: string;
  description?: string;
  /** Path only, e.g. "/about". Canonical is derived from it. */
  path?: string;
  lang?: Lang;
  /** Extra JSON-LD object injected into <head>. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  ogImage?: string;
  ogType?: string;
  publishedAt?: string;
  tags?: string[];
}

const {
  title,
  description = SITE.description,
  path = "/",
  lang = "id",
  jsonLd,
  noindex = false,
  ogImage = "/og-default.png",
  ogType = "website",
  publishedAt,
  tags = [],
} = Astro.props;

const canonical = new URL(path, SITE.url).toString();
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.role}`;

const MENU = [
  { key: "home", url: "/" },
  { key: "about", url: "/about" },
  { key: "projects", url: "/projects" },
  { key: "blogs", url: "/blogs" },
  { key: "now", url: "/now" },
  { key: "uses", url: "/uses" },
  { key: "contact", url: "/contact" },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (url: string) => (url === "/" ? current === "/" : current === url || current.startsWith(url + "/"));

// Theme is resolved before first paint by an inline script that only touches
// <html>. No React, no hydration, therefore no mismatch: whatever the script
// decides is what the CSS paints from the very first frame.
const themeScript = `(function(){try{var s=localStorage.getItem("theme");var d=window.matchMedia("(prefers-color-scheme: dark)").matches;var t=s==="light"||s==="dark"?s:(d?"dark":"light");document.documentElement.classList.toggle("dark",t==="dark");}catch(e){document.documentElement.classList.add("dark");}})();`;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, SITE.url).toString()} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, SITE.url).toString()} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="google-site-verification" content={SITE.googleVerification} />
    <link rel="preload" as="image" href={AVATAR_URL} />

    <script is:inline set:html={themeScript} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="mx-auto max-w-6xl px-3 lg:px-4">
      <div class="flex flex-col lg:flex-row lg:gap-6 lg:pt-6">
        <aside class="sticky top-0 z-10 flex flex-col lg:py-8 lg:h-full lg:w-64">
          <div class="bg-card text-card-foreground rounded-md p-5 lg:p-4 shadow-sm lg:shadow-none">
            <div class="flex flex-row lg:flex-col gap-4">
              <div class="flex items-center gap-3">
                <div class="relative shrink-0">
                  <div aria-hidden="true" class="absolute -inset-1 rounded-full bg-gradient-to-tr from-sky-400 via-cyan-400 to-indigo-600 blur-[3px] opacity-70 sidebar-ring"></div>
                  <div class="relative size-12 lg:size-16 rounded-full overflow-hidden bg-gradient-to-br from-sky-400 to-indigo-600 ring-2 ring-background">
                    <img src={AVATAR_URL} alt={SITE.name} loading="eager" width="64" height="64" class="size-full object-cover object-top" />
                  </div>
                  <span class="absolute bottom-0 right-0 size-3.5 rounded-full bg-emerald-500 ring-2 ring-card">
                    <span class="absolute inset-0 rounded-full bg-emerald-500 animate-ping opacity-75"></span>
                  </span>
                </div>
                <div class="lg:mt-2">
                  <p class="font-semibold font-sora leading-tight">{SITE.name}</p>
                  <p class="text-xs text-muted-foreground">{SITE.role}</p>
                </div>
              </div>

              <div class="flex items-center gap-2 lg:mt-2 ml-auto lg:ml-0">
                <button id="theme-toggle" type="button" aria-label="Toggle theme" class="inline-flex items-center justify-center size-9 rounded-md border hover:bg-accent hover:text-accent-foreground transition-colors">
                  <svg class="size-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                  <svg class="size-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                </button>
                <button id="lang-toggle" type="button" aria-label="Toggle language" class="inline-flex items-center justify-center h-9 px-2.5 rounded-md border text-xs font-medium hover:bg-accent hover:text-accent-foreground transition-colors">
                  {lang === "id" ? "EN" : "ID"}
                </button>
              </div>
            </div>

            <div role="separator" class="my-4 h-px w-full bg-border"></div>

            <nav class="flex flex-row flex-wrap lg:flex-col gap-1">
              {MENU.map((row) => (
                <a
                  href={row.url}
                  aria-label={t(lang, `nav.${row.key}`)}
                  aria-current={isActive(row.url) ? "page" : undefined}
                  class:list={[
                    "inline-flex items-center justify-start gap-3 rounded-md px-4 py-2 text-sm font-medium transition-transform hover:translate-x-1",
                    isActive(row.url) ? "bg-secondary text-secondary-foreground" : "hover:bg-accent hover:text-accent-foreground",
                  ]}
                >
                  {t(lang, `nav.${row.key}`)}
                </a>
              ))}
            </nav>

            <div role="separator" class="my-4 h-px w-full bg-border"></div>

            <div class="flex gap-3 text-sm text-muted-foreground">
              <a href={SOCIAL.github} target="_blank" rel="noreferrer" class="hover:text-foreground">GitHub</a>
              <a href={SOCIAL.linkedin} target="_blank" rel="noreferrer" class="hover:text-foreground">LinkedIn</a>
            </div>
          </div>
        </aside>

        <main class="w-full lg:max-w-[854px] lg:mt-2 lg:min-h-screen">
          <div class="mt-6 lg:mt-2">
            <slot />
          </div>
          <footer class="mt-16 border-t py-8 text-center text-sm text-muted-foreground">
            <p>
              © {new Date().getFullYear()} {SITE.name} ·{" "}
              <a href={SOCIAL.github} target="_blank" rel="noreferrer" class="hover:text-foreground">@evairo176</a>
            </p>
            <p class="mt-1 text-xs">Built static with Astro · Markdown content</p>
          </footer>
        </main>
      </div>
    </div>

    <a id="to-top" href="#top" class="fixed bottom-6 right-6 hidden size-10 place-items-center rounded-full border bg-card text-card-foreground shadow-md hover:bg-accent" aria-label="Scroll to top">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </a>

    <script is:inline>
      // Progressive enhancement only. Nothing here changes the rendered content,
      // so no-JS visitors and crawlers get the full page.
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById("theme-toggle");
        btn &&
          btn.addEventListener("click", function () {
            var isDark = root.classList.toggle("dark");
            try { localStorage.setItem("theme", isDark ? "dark" : "light"); } catch (e) {}
          });

        var langBtn = document.getElementById("lang-toggle");
        langBtn &&
          langBtn.addEventListener("click", function () {
            var cur = root.getAttribute("lang") === "id" ? "en" : "id";
            var url = new URL(window.location.href);
            url.searchParams.set("lang", cur);
            window.location.href = url.toString();
          });

        var top = document.getElementById("to-top");
        top && top.classList.add("hidden");
        window.addEventListener("scroll", function () {
          if (!top) return;
          top.classList.toggle("hidden", window.scrollY < 400);
          top.classList.toggle("grid", window.scrollY >= 400);
        }, { passive: true });
      })();
    </script>

    <style is:inline>
      @keyframes spin-slow { to { transform: rotate(360deg); } }
      .sidebar-ring { animation: spin-slow 8s linear infinite; }
      @media (prefers-reduced-motion: reduce) { .sidebar-ring { animation: none; } }
      @media (prefers-reduced-motion: reduce) { .animate-ping { animation: none; } }
    </style>
  </body>
</html>
